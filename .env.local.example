# Copy this file to `.env.local` and add your Mapbox access token.
#
#   cp .env.local.example .env.local
#
# Get a free token at https://account.mapbox.com/access-tokens/
# The NEXT_PUBLIC_ prefix is required so the token is exposed to the browser
# (Mapbox GL JS runs client-side).

NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token_here

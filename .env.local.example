# Copy to .env.local and fill in.

# --- Stripe (required for checkout) ---
# Get your keys at https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) while developing, live keys (sk_live_...) in prod.
STRIPE_SECRET_KEY=sk_test_your_key_here

# --- Site URL ---
# Public base URL, used for Stripe success/cancel redirects and Open Graph.
# On Vercel this is auto-detected from VERCEL_URL; set it explicitly for your
# custom domain in production and for local testing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
